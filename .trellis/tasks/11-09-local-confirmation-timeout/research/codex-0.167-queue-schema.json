      ],
      "title": "ThreadQueueDeleteResponse",
      "type": "object"
    },
    "ThreadQueueStartParams": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "queuedSubmissionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "threadId": {
          "type": "string"
        }
      },
      "required": [
        "threadId"
      ],
      "title": "ThreadQueueStartParams",
      "type": "object"
    },
    "ThreadQueueStartResponse": {
