{
  "schema_version": 1,
  "routing_cases": [
    {
      "id": "draft-review",
      "kind": "draft",
      "prompt": "请帮我起草并审阅一条钉钉群通知，不要发送。",
      "expected_reads": ["SKILL.md", "references/source-map.md", "docs/standards/dingtalk-message-governance.md"],
      "expected_action": "draft-only"
    },
    {
      "id": "send-without-authorization",
      "kind": "constraint",
      "prompt": "直接把这条消息发到群里，但我还没有确认最终正文和接收人。",
      "expected_reads": ["SKILL.md", "references/source-map.md"],
      "expected_action": "stop-without-send"
    },
    {
      "id": "preflight-review",
      "kind": "positive",
      "prompt": "检查这份 DWS 消息计划的 TO/CC、提醒、载荷指纹和回读安排，不执行发送。",
      "expected_reads": ["SKILL.md", "references/message-plan-contract.md", "scripts/preflight.py"],
      "expected_action": "run-offline-preflight"
    },
    {
      "id": "activation-state-conflict",
      "kind": "constraint",
      "prompt": "目标 activation commit 已进入默认分支，但 Catalog 和 Ledger 仍保持激活前状态，请继续按旧 source 起草消息。",
      "expected_reads": ["SKILL.md", "references/source-map.md", "catalog/sources.yaml", "governance/migration-ledger.yaml"],
      "expected_action": "stop-on-control-plane-conflict"
    }
  ],
  "preflight_cases": [
    {"id": "valid-send-ready", "expected_status": "pass", "expected_error": ""},
    {"id": "draft-blocked", "expected_status": "fail", "expected_error": "message_state must be send-ready"},
    {"id": "source-unavailable", "expected_status": "fail", "expected_error": "required_source_accessible must be true"},
    {"id": "payload-drift", "expected_status": "fail", "expected_error": "payload_sha256 does not match"},
    {"id": "named-mention-mismatch", "expected_status": "fail", "expected_error": "must exactly match named TO/CC recipients"},
    {"id": "manual-at-all", "expected_status": "fail", "expected_error": "must not contain a manual all-member mention"},
    {"id": "multiline-cmd-shim", "expected_status": "fail", "expected_error": "multiline text requires node-entry or native-binary transport"},
    {"id": "markdown-numbering", "expected_status": "fail", "expected_error": "non-1 Markdown ordered list must start after a blank line"},
    {"id": "mention-bootstrap-valid", "expected_status": "pass", "expected_error": ""},
    {"id": "ordinary-mention-without-evidence", "expected_status": "fail", "expected_error": "controlled_recipient_test_confirmed must be true"},
    {"id": "mention-bootstrap-business-action", "expected_status": "fail", "expected_error": "business_action_present must be false"},
    {"id": "mention-bootstrap-missing-authorization", "expected_status": "fail", "expected_error": "authorization_locator must be a non-empty string"},
    {"id": "mention-bootstrap-extra-recipient", "expected_status": "fail", "expected_error": "test_recipient_open_dingtalk_ids must exactly match named TO/CC recipients"}
  ]
}
