{
  "name": "flower-trellis",
  "version": "0.5.0-beta.7",
  "description": "一键安装/升级 Trellis 并自动融合 skill-garden 强化包(默认 Claude + agents)",
  "type": "module",
  "bin": {
    "flower-trellis": "./bin/flower-trellis.js",
    "ftl": "./bin/flower-trellis.js",
    "ft": "./bin/flower-trellis.js"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@mindfoldhq/trellis": "0.6.5",
    "chalk": "^5.6.2",
    "figlet": "^1.11.0",
    "node-pty": "^1.1.0"
  },
  "files": [
    "bin",
    "src",
    "enhancements",
    "!enhancements/**/__pycache__",
    "!enhancements/**/*.pyc",
    "scripts/sync-global-trellis.mjs",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/js/*.test.js && python3 -m unittest discover -s test/python -p 'test_*.py' && node scripts/check-patch-conflicts.mjs && node scripts/check-ai-context-budget.mjs",
    "sync": "node scripts/sync-enhancements.mjs",
    "postinstall": "node scripts/sync-global-trellis.mjs",
    "prepublishOnly": "node scripts/sync-enhancements.mjs",
    "release": "node scripts/check-snapshot.mjs && commit-and-tag-version",
    "release:dry": "commit-and-tag-version --dry-run"
  },
  "commit-and-tag-version": {
    "scripts": {
      "postchangelog": "node scripts/write-release-notes-metadata.mjs"
    }
  },
  "keywords": [
    "trellis",
    "skill-garden",
    "ai",
    "workflow",
    "claude",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilentFlower/flower-trellis.git"
  },
  "bugs": {
    "url": "https://github.com/SilentFlower/flower-trellis/issues"
  },
  "homepage": "https://github.com/SilentFlower/flower-trellis#readme",
  "license": "MIT",
  "devDependencies": {
    "commit-and-tag-version": "^12.7.3"
  },
  "flowerReleaseNotes": {
    "version": "0.5.0-beta.7",
    "source": "CHANGELOG.md",
    "body": "### ✨ 新功能 Features\n\n* **0.6:** 首次实现默认检查，连续调整可暂缓后续 Check-All ([d8a3dcd](https://github.com/SilentFlower/flower-trellis/commit/d8a3dcdd7c9783af7ac1223a0b7be0c513d8bd00))\n\n\n### 🐛 修复 Bug Fixes\n\n* **0.6:** 防止 Python 写入失败导致任务与 session 状态漂移 ([74d5d12](https://github.com/SilentFlower/flower-trellis/commit/74d5d12dd26e19133b591e24b1a762dac20ec17d))",
    "truncated": false
  }
}
