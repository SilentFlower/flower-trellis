{
  "schemaVersion": 2,
  "id": "flower-codex-dispatch-mode",
  "purpose": "platform_config",
  "operations": [{
    "id": "flower-codex-dispatch-mode",
    "operation": "replace",
    "targets": [{
      "kind": "yaml",
      "path": ".trellis/config.yaml",
      "missing": "create",
      "requires": [".codex"]
    }],
    "selector": { "type": "yaml-key", "path": "codex.dispatch_mode" },
    "content": { "source": "config-content.json.txt" }
  }, {
    "id": "flower-codex-route-capability-hook",
    "operation": "replace",
    "targets": [{
      "kind": "file",
      "path": ".codex/hooks/inject-workflow-state.py",
      "missing": "skip",
      "markerStyle": "hash",
      "requires": [".codex"]
    }],
    "selector": { "type": "literal", "source": "hook-selector.py" },
    "content": { "source": "hook-content.py" }
  }]
}
