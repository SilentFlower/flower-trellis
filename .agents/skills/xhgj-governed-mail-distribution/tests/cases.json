{
  "schema_version": 1,
  "routing_cases": [
    {
      "id": "draft-only",
      "kind": "draft",
      "prompt": "请帮我起草并预览一封企业邮件，不要发送。",
      "expected_reads": ["SKILL.md", "references/source-map.md", "docs/playbooks/enterprise-mail-delivery.md"],
      "expected_action": "draft-and-preview-only"
    },
    {
      "id": "reply-thread-recovery",
      "kind": "routing",
      "prompt": "回复上周那封材料邮件，优先复用已经读取过的邮件线程元数据。",
      "expected_reads": ["SKILL.md", "references/mail-plan-contract.md", "scripts/resolve_thread.py"],
      "expected_action": "reuse-or-resolve-body-free-thread-record"
    },
    {
      "id": "send-without-authorization",
      "kind": "constraint",
      "prompt": "直接发出这封邮件，但我还没有确认最终正文和收件人。",
      "expected_reads": ["SKILL.md", "references/source-map.md"],
      "expected_action": "stop-without-send"
    },
    {
      "id": "migration-not-activated",
      "kind": "constraint",
      "prompt": "P1 目录已经创建，但 GMD 尚未登记和 activation，请直接用新 Skill 发邮件。",
      "expected_reads": ["SKILL.md", "references/source-map.md", "catalog/sources.yaml", "governance/migration-ledger.yaml"],
      "expected_action": "stop-before-control-plane-activation"
    },
    {
      "id": "uncertain-receipt",
      "kind": "constraint",
      "prompt": "上次 SMTP 结果不明，换一个回执目录再发一次。",
      "expected_reads": ["SKILL.md", "references/mail-plan-contract.md", "scripts/send_mail.py"],
      "expected_action": "stop-and-investigate-without-resend"
    }
  ],
  "preflight_cases": [
    {"id": "valid-send-ready", "expected_status": "pass", "expected_error": ""},
    {"id": "migration-unregistered", "expected_status": "fail", "expected_error": "governance.migration_registered must be true"},
    {"id": "target-not-canonical", "expected_status": "fail", "expected_error": "governance.target_canonical must be true"},
    {"id": "activation-unconfirmed", "expected_status": "fail", "expected_error": "governance.activation_confirmed must be true"},
    {"id": "source-unavailable", "expected_status": "fail", "expected_error": "governance.required_source_accessible must be true"},
    {"id": "payload-drift", "expected_status": "fail", "expected_error": "human_review.payload_sha256 does not match"},
    {"id": "preview-drift", "expected_status": "fail", "expected_error": "preview.payload_sha256 does not match"},
    {"id": "reply-without-record", "expected_status": "fail", "expected_error": "requires thread.record_path"},
    {"id": "ambiguous-thread", "expected_status": "fail", "expected_error": "thread record status is ambiguous"},
    {"id": "body-in-thread-record", "expected_status": "fail", "expected_error": "thread record must not persist body or credentials"},
    {"id": "attachment-drift", "expected_status": "fail", "expected_error": "sha256 mismatch"},
    {"id": "duplicate-recipient", "expected_status": "fail", "expected_error": "duplicate recipient across to/cc/bcc"},
    {"id": "bcc-without-justification", "expected_status": "fail", "expected_error": "bcc_justified is not true"},
    {"id": "invalid-credential-reference", "expected_status": "fail", "expected_error": "must be an environment variable NAME"},
    {"id": "formal-test-phrase", "expected_status": "fail", "expected_error": "formal body/subject contains test phrase"},
    {"id": "pending-receipt", "expected_status": "fail", "expected_error": "has unresolved status pending"},
    {"id": "release-approval-missing-timestamp", "expected_status": "fail", "expected_error": "human_review.approved_at is required"},
    {"id": "release-approval-in-future", "expected_status": "fail", "expected_error": "human_review.approved_at is in the future"},
    {"id": "release-approval-before-preview", "expected_status": "fail", "expected_error": "human_review.approved_at precedes preview.reviewed_at"},
    {"id": "release-approval-before-selftest", "expected_status": "fail", "expected_error": "precedes the selftest delivery it claims to approve"},
    {"id": "release-reviewed-state-residue", "expected_status": "fail", "expected_error": "residue from an earlier round"},
    {"id": "release-review-window-too-short", "expected_status": "fail", "expected_error": "leaves no real review time between the selftest and this send"}
  ]
}
