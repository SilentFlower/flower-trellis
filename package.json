{
  "name": "flower-trellis",
  "version": "0.6.0-beta.8",
  "description": "一键安装/升级 Trellis 并自动融合 skill-garden 强化包(默认 Claude + agents)",
  "type": "module",
  "bin": {
    "flower-trellis": "./bin/flower-trellis.js",
    "ftl": "./bin/flower-trellis.js",
    "ft": "./bin/flower-trellis.js"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "@inquirer/core": "^11.2.1",
    "@inquirer/prompts": "^8.5.2",
    "@mindfoldhq/trellis": "0.6.12",
    "ajv": "^8.20.0",
    "chalk": "^5.6.2",
    "figlet": "^1.11.0",
    "node-pty": "^1.1.0",
    "semver": "^7.8.5",
    "tar": "^7.5.22"
  },
  "files": [
    "bin",
    "src",
    "!src/lib/patch-fixture.js",
    "enhancements",
    "!enhancements/**/__pycache__",
    "!enhancements/**/*.pyc",
    "scripts/sync-global-trellis.mjs",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/js/*.test.js && python3 -m unittest discover -s test/python -p 'test_*.py' && node scripts/check-patch-conflicts.mjs && npm run patch:targets:check && node scripts/check-ai-context-budget.mjs && node scripts/check-output-templates.mjs",
    "sync": "node scripts/sync-enhancements.mjs",
    "patch:targets": "node scripts/run-skill-garden-compiled-targets.mjs",
    "patch:targets:check": "node scripts/run-skill-garden-compiled-targets.mjs --check",
    "postinstall": "node scripts/sync-global-trellis.mjs",
    "prepublishOnly": "node scripts/sync-enhancements.mjs",
    "release": "node scripts/check-snapshot.mjs && commit-and-tag-version",
    "release:dry": "commit-and-tag-version --dry-run"
  },
  "commit-and-tag-version": {
    "scripts": {
      "postchangelog": "node scripts/write-release-notes-metadata.mjs"
    }
  },
  "keywords": [
    "trellis",
    "skill-garden",
    "ai",
    "workflow",
    "claude",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilentFlower/flower-trellis.git"
  },
  "bugs": {
    "url": "https://github.com/SilentFlower/flower-trellis/issues"
  },
  "homepage": "https://github.com/SilentFlower/flower-trellis#readme",
  "license": "MIT",
  "devDependencies": {
    "commit-and-tag-version": "^12.7.3"
  },
  "flowerReleaseNotes": {
    "version": "0.6.0-beta.8",
    "source": "CHANGELOG.md",
    "body": "### ✨ 新功能 Features\n\n* **worktree:** 完善多仓预检与会话交接 ([362d42c](https://github.com/SilentFlower/flower-trellis/commit/362d42c4d78e3bd544554975c10fa2db3b1d9729))\n\n\n### 🐛 修复 Bug Fixes\n\n* **plugin:** 修复 Plugin 管理器加载、预览噪音与更新链路 ([ee45d43](https://github.com/SilentFlower/flower-trellis/commit/ee45d433810c2eca90a6622bd7b5cca56b7bb027))",
    "truncated": false
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  }
}
