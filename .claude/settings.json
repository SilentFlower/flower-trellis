{
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .trellis/scripts/flower_update_hook.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .trellis/scripts/flower_session_start.py --hook .claude/hooks/session-start.py --part state",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 .trellis/scripts/flower_session_start.py --hook .claude/hooks/session-start.py --part rules",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 .trellis/scripts/flower_session_start.py --hook .claude/hooks/session-start.py --part stages",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 .trellis/scripts/flower_telemetry_hook.py --platform claude",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/inject-subagent-context.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/inject-subagent-context.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ftl confirm hook",
            "timeout": 2,
            "if": "Bash(ftl confirm *)"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/inject-workflow-state.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "ftl confirm hook",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "python3 .trellis/scripts/flower_telemetry_hook.py --platform claude",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ftl confirm hook",
            "timeout": 2,
            "if": "Bash(ftl confirm *)"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "ftl confirm hook",
            "timeout": 2
          }
        ]
      }
    ]
  },
  "enabledPlugins": {}
}
