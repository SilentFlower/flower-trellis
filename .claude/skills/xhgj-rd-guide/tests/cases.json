{
  "schema_version": 2,
  "required_output_sections": ["路由结果", "生效约束", "未读取边界", "下一步"],
  "cases": [
    {
      "id": "positive-multi-session",
      "kind": "positive",
      "prompt": "我要把一个跨仓治理任务拆成两个会话，应该先读什么？",
      "expected_routes": ["docs/playbooks/multi-session-workflow.md"],
      "expected_action": "continue"
    },
    {
      "id": "negative-ordinary-code",
      "kind": "negative",
      "prompt": "修复这个 Java 方法的空指针异常。",
      "expected_routes": [],
      "expected_action": "continue-original-workflow"
    },
    {
      "id": "failure-required-source",
      "kind": "required-source-unreachable",
      "prompt": "这个动作依赖 required-source，但当前无权限读取原文。",
      "expected_routes": ["docs/architecture/knowledge-source-model.md"],
      "expected_action": "stop"
    },
    {
      "id": "failure-authority-conflict",
      "kind": "authority-conflict",
      "prompt": "两份来源对同一 scope 都声明 canonical，而且 authority 结论冲突。",
      "expected_routes": ["catalog/sources.yaml", "governance/authority-registry.yaml"],
      "expected_action": "stop-calibrate-then-create-dedicated-issue"
    },
    {
      "id": "authority-conflict-matching-existing-issue",
      "kind": "authority-conflict",
      "prompt": "冲突双方都属于 rd-guide-maintainers 的控制面规则范围，Registry 明确登记 issue:1 且该 issue 承接当前范围。",
      "expected_routes": ["catalog/sources.yaml", "governance/authority-registry.yaml", "issue:1"],
      "expected_action": "stop-and-route-matching-existing-issue"
    },
    {
      "id": "authority-conflict-distinct-feedback",
      "kind": "authority-conflict",
      "prompt": "测试场景中双方规则负责人登记了不同且可达的反馈 issue，双方结论冲突。",
      "expected_routes": ["catalog/sources.yaml", "governance/authority-registry.yaml", "issue:41", "issue:42"],
      "expected_action": "stop-and-request-joint-calibration"
    },
    {
      "id": "skill-routing-defect",
      "kind": "skill-defect",
      "prompt": "xhgj-rd-guide 把普通内容冲突错误路由到 issue:1，这是 Skill 自身的路由缺口。",
      "expected_routes": ["contract.yaml", "issue:3"],
      "expected_action": "report-skill-defect"
    },
    {
      "id": "degrade-optional-detail",
      "kind": "optional-detail-unreachable",
      "prompt": "公开摘要足以执行，但 optional-detail 原文当前不可达。",
      "expected_routes": ["docs/architecture/knowledge-source-model.md"],
      "expected_action": "continue-with-boundary"
    },
    {
      "id": "route-external-git-optional-detail",
      "kind": "source-route",
      "prompt": "请按 src-dingtalk-workspace-cli-upstream 的 kind=external-git、authority=rd-guide-maintainers、reference_mode=optional-detail 定位钉定版本的上游详情。",
      "expected_routes": ["docs/architecture/knowledge-source-model.md", "catalog/sources.yaml", "governance/authority-registry.yaml", "https://github.com/DingTalk-Real-AI/dingtalk-workspace-cli"],
      "expected_action": "read-pinned-optional-detail"
    },
    {
      "id": "route-dingtalk-wiki-catalog-only",
      "kind": "source-route",
      "prompt": "请按 src-digital-rd-team-wiki-projection 的 kind=dingtalk-wiki、authority=rd-guide-maintainers、reference_mode=catalog-only 判断是否可作为当前唯一执行依据。",
      "expected_routes": ["docs/architecture/knowledge-source-model.md", "catalog/sources.yaml", "governance/authority-registry.yaml", "https://alidocs.dingtalk.com/i/spaces/VJqzq4MqoVAyNGYE/overview"],
      "expected_action": "use-catalog-only-candidate-projection"
    },
    {
      "id": "project-trellis-present",
      "kind": "trellis-present",
      "prompt": "当前业务仓存在 .trellis/spec/release-check.md，请定位本项目上线前检查规则。",
      "expected_routes": [".trellis/spec/release-check.md"],
      "expected_action": "read-local-only"
    },
    {
      "id": "project-trellis-absent",
      "kind": "trellis-absent",
      "prompt": "当前业务仓没有 .trellis/spec/，是否要从外部系统同步一份？",
      "expected_routes": [],
      "expected_action": "do-not-invent-or-sync"
    },
    {
      "id": "failure-main-version-not-installed",
      "kind": "installation-effectiveness",
      "prompt": "仓内 main 已是 0.3.0，但当前 Agent 安装副本还是 0.2.0，能否宣称新检查已生效？",
      "expected_routes": ["docs/playbooks/skill-controlled-installation.md", "installed-skill/contract.yaml"],
      "expected_action": "report-installation-gap-and-stop"
    }
  ],
  "deterministic_cases": [
    {
      "id": "failure-required-source-stale-fallback",
      "kind": "required-source-access",
      "input": {
        "required": true,
        "current_source_accessible": false,
        "used_stale_material": true,
        "action": "continue"
      },
      "expected_error": "required-current-source-unreachable"
    },
    {
      "id": "failure-authority-conflict-locator-omission",
      "kind": "authority-conflict-routing",
      "input": {
        "conflict_detected": true,
        "read_paths": ["docs/architecture/knowledge-source-model.md"],
        "output_routes": ["docs/architecture/knowledge-source-model.md"]
      },
      "expected_error": "authority-conflict-control-plane-locators-missing"
    },
    {
      "id": "failure-catalog-only-stable-locator-omission",
      "kind": "catalog-only-routing",
      "input": {
        "reference_mode": "catalog-only",
        "stable_locator": "https://alidocs.dingtalk.com/i/spaces/VJqzq4MqoVAyNGYE/overview",
        "output_routes": ["catalog/sources.yaml"],
        "claims_unique_execution_basis": false
      },
      "expected_error": "catalog-only-stable-locator-missing"
    },
    {
      "id": "failure-main-only-effectiveness-claim",
      "kind": "installation-effectiveness",
      "input": {
        "canonical_version": "0.3.0",
        "installed": true,
        "installed_version": "0.2.0",
        "claim_effective": true
      },
      "expected_error": "installation-version-not-effective"
    }
  ]
}
